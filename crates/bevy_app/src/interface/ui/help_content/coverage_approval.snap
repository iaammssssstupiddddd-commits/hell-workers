launcher|label="Help"|tooltip="操作とゲームのヘルプ"|shortcut="F1"
chrome-copy|panel-title="Hell Workers ヘルプ"|close-label="閉じる"|topic-navigation-label="項目移動"|page-navigation-label="ページ移動"|document-bounds-label="先頭 / 末尾"|shortcut-label="操作"
chrome-render|close-button="閉じる (F1 / Esc)"|footer="F1 / Esc: 閉じる  ↑ / ↓: 項目移動  PageUp / PageDown: ページ移動  Home / End: 先頭 / 末尾"|shortcut-sample="操作: <binding>"
