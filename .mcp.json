{
  "mcpServers": {
    "rust-analyzer-mcp": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/rust_analyzer_mcp_stdio_adapter.py",
        "rust-analyzer-mcp"
      ]
    },
    "docsrs-mcp": {
      "type": "stdio",
      "command": "docsrs-mcp",
      "args": []
    },
    "blender": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-.}/tools/blender_ai_workflow/bin/blender-mcp-server",
      "args": [],
      "env": {
        "BLENDER_BIN": "${CLAUDE_PROJECT_DIR:-.}/tools/blender_ai_workflow/bin/blender-safe",
        "BLENDER_MCP_ALLOW_HEADLESS": "0",
        "BLENDER_MCP_ALLOW_PYTHON_EXEC": "0",
        "HELL_WORKERS_ASSET_ROOT": "${HOME}/Sync/hell-workers-assets"
      }
    }
  }
}
