{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cachePriming": {
          "enable": false
        },
        "lru": {
          "capacity": 32
        },
        "cargo": {
          "allTargets": false
        },
        "check": {
          "workspace": false
        },
        "files": {
          "exclude": ["target", "dist", ".trunk", "logs"]
        }
      }
    }
  }
}
