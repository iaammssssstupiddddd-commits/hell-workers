#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "usage: export-staging-glb <input.blend> <output-name.glb> [max-triangles] [--collection <exact-name>]" >&2
    exit 2
fi

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
ASSET_WORKSPACE_ROOT="${HELL_WORKERS_ASSET_ROOT:-${HOME}/Sync/hell-workers-assets}"
INPUT_BLEND="$1"
OUTPUT="${ASSET_WORKSPACE_ROOT}/staging/exports/$2"
REPORT="${ASSET_WORKSPACE_ROOT}/staging/reports/$2.export.json"
MAX_TRIANGLES="${3:-}"
if [[ -n "${MAX_TRIANGLES}" && "${MAX_TRIANGLES}" == --* ]]; then
    MAX_TRIANGLES=""
else
    [[ $# -lt 3 ]] || shift
fi
shift 2
COLLECTION=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --collection)
            [[ $# -ge 2 && -z "${COLLECTION}" ]] || { echo "invalid --collection" >&2; exit 2; }
            COLLECTION="$2"
            shift 2
            ;;
        *)
            echo "unknown argument: $1" >&2
            exit 2
            ;;
    esac
done
export BLENDER_SAFE_NO_NETWORK=1

EXTRA_ARGS=()
if [[ -n "${MAX_TRIANGLES}" ]]; then
    EXTRA_ARGS+=(--max-triangles "${MAX_TRIANGLES}")
fi
if [[ -n "${COLLECTION}" ]]; then
    EXTRA_ARGS+=(--collection "${COLLECTION}" --require-single-mesh)
fi

"${BIN_DIR}/blender-safe" \
    --background \
    --factory-startup \
    "${INPUT_BLEND}" \
    --python-exit-code 2 \
    --python "${WORKFLOW_ROOT}/scripts/export_glb.py" \
    -- \
    --output "${OUTPUT}" \
    --report "${REPORT}" \
    --require-uv \
    --require-material \
    "${EXTRA_ARGS[@]}"

exec "${BIN_DIR}/gltf-validate" \
    "${OUTPUT}" \
    --report "${ASSET_WORKSPACE_ROOT}/staging/reports/$2.khronos.json"
