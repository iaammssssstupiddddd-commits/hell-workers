#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${BIN_DIR}/.." && pwd)"

exec "${WORKFLOW_ROOT}/bin/blender-safe" \
  --background --factory-startup --python-exit-code 2 \
  --python "${WORKFLOW_ROOT}/scripts/create_door_production_scene.py"
