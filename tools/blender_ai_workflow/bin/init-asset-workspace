#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
ASSET_WORKSPACE_ROOT="${HELL_WORKERS_ASSET_ROOT:-${HOME}/Sync/hell-workers-assets}"

install -d \
    "${ASSET_WORKSPACE_ROOT}/source/blender" \
    "${ASSET_WORKSPACE_ROOT}/source/generated" \
    "${ASSET_WORKSPACE_ROOT}/source/references" \
    "${ASSET_WORKSPACE_ROOT}/staging/imports" \
    "${ASSET_WORKSPACE_ROOT}/staging/blend" \
    "${ASSET_WORKSPACE_ROOT}/staging/exports" \
    "${ASSET_WORKSPACE_ROOT}/staging/renders" \
    "${ASSET_WORKSPACE_ROOT}/staging/reports" \
    "${ASSET_WORKSPACE_ROOT}/staging/snapshots" \
    "${ASSET_WORKSPACE_ROOT}/exports/models" \
    "${ASSET_WORKSPACE_ROOT}/exports/textures" \
    "${ASSET_WORKSPACE_ROOT}/exports/audio" \
    "${ASSET_WORKSPACE_ROOT}/manifests" \
    "${ASSET_WORKSPACE_ROOT}/licenses"

cp --no-clobber \
    "${WORKFLOW_ROOT}/templates/asset-workspace.README.md" \
    "${ASSET_WORKSPACE_ROOT}/README.md"
cp --no-clobber \
    "${WORKFLOW_ROOT}/templates/asset-manifest.template.json" \
    "${ASSET_WORKSPACE_ROOT}/manifests/asset-manifest.template.json"
cp --no-clobber \
    "${WORKFLOW_ROOT}/templates/licenses.README.md" \
    "${ASSET_WORKSPACE_ROOT}/licenses/README.md"

echo "ASSET_WORKSPACE_READY root=${ASSET_WORKSPACE_ROOT}"
