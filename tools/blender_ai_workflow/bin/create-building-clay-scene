#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
export BLENDER_SAFE_NO_NETWORK=1
export OCIO="${WORKFLOW_ROOT}/fixtures/wall-calibration-v2.ocio"

exec "${BIN_DIR}/blender-safe" \
    --background --factory-startup --python-exit-code 2 \
    --python "${WORKFLOW_ROOT}/scripts/create_building_clay_scene.py" -- "$@"
