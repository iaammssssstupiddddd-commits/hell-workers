#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: render-door-previews <door-production-v1.blend>" >&2
  exit 2
fi

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
ASSET_ROOT="${HELL_WORKERS_ASSET_ROOT:-${HOME}/Sync/hell-workers-assets}"
export HELL_WORKERS_ASSET_ROOT="${ASSET_ROOT}"
export BLENDER_SAFE_NO_NETWORK=1
export OCIO="${WORKFLOW_ROOT}/fixtures/wall-calibration-v2.ocio"

exec "${WORKFLOW_ROOT}/bin/blender-safe" \
  --background --factory-startup "$1" --python-exit-code 2 \
  --python "${WORKFLOW_ROOT}/scripts/render_door_previews.py"
